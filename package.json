{
  "name": "@mocaos/cortex",
  "version": "1.2.3",
  "description": "Interactive installer for self-hosted Cortex",
  "license": "Apache-2.0",
  "author": "mocaOS",
  "homepage": "https://github.com/mocaOS/cortex-installer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mocaOS/cortex-installer.git"
  },
  "bugs": {
    "url": "https://github.com/mocaOS/cortex-installer/issues"
  },
  "keywords": [
    "cortex",
    "installer",
    "self-hosted",
    "knowledge-base",
    "rag",
    "neo4j"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "cortex": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test --import tsx test/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
